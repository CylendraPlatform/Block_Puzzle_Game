extends SceneTree
## Audit every level and write docs/LEVEL_QUALITY_REPORT.md with per-level metrics
## and quality flags. Flags trivial (par<=1 past the intro) and sparse levels.
##   godot --headless --path . --script res://test/audit_levels.gd

func _initialize() -> void:
	var dir := DirAccess.open("res://levels")
	var files: Array[String] = []
	dir.list_dir_begin()
	var f := dir.get_next()
	while f != "":
		if f.ends_with(".json"):
			files.append(f)
		f = dir.get_next()
	dir.list_dir_end()
	files.sort()

	var rows: Array = []
	var par_hist := {}
	var flags: Array[String] = []
	for name in files:
		var fr := FileAccess.open("res://levels/" + name, FileAccess.READ)
		var d: Dictionary = JSON.parse_string(fr.get_as_text())
		var lv := Level.from_dict(d)
		var colors := {}
		for b in lv.blocks:
			colors[b["color"]] = true
		var total := lv.cols * lv.rows
		var filled := 0
		for b in lv.blocks:
			filled += b["cells"].size()
		var free_ratio := float(total - filled - lv.walls.size()) / float(total)
		var par := int(d.get("par", 0))
		par_hist[par] = int(par_hist.get(par, 0)) + 1
		rows.append({
			"id": lv.id, "size": "%dx%d" % [lv.cols, lv.rows], "blocks": lv.blocks.size(),
			"colors": colors.size(), "walls": lv.walls.size(), "par": par,
			"free": "%d%%" % int(free_ratio * 100.0),
		})
		if lv.id > 1 and par <= 1:
			flags.append("L%d: trivial (par %d)" % [lv.id, par])
		if lv.id > 5 and lv.blocks.size() < 2:
			flags.append("L%d: only %d block(s)" % [lv.id, lv.blocks.size()])

	var out := "# Level Quality Report\n\n"
	out += "_Generated by test/audit_levels.gd over %d levels._\n\n" % files.size()
	out += "## Difficulty distribution (par = shortest solution, moves)\n\n| par | count |\n|----:|------:|\n"
	var pars := par_hist.keys()
	pars.sort()
	for p in pars:
		out += "| %d | %d |\n" % [p, par_hist[p]]
	out += "\n## Flags (%d)\n\n" % flags.size()
	if flags.is_empty():
		out += "None - no trivial or sparse levels past the intro.\n"
	else:
		for s in flags:
			out += "- %s\n" % s
	out += "\n## Per-level metrics\n\n| Level | Size | Blocks | Colors | Walls | Par | Free |\n"
	out += "|------:|:----:|:------:|:------:|:-----:|:---:|:----:|\n"
	for r in rows:
		out += "| %d | %s | %d | %d | %d | %d | %s |\n" % [r["id"], r["size"], r["blocks"], r["colors"], r["walls"], r["par"], r["free"]]

	var w := FileAccess.open("res://docs/LEVEL_QUALITY_REPORT.md", FileAccess.WRITE)
	w.store_string(out)
	print("flags=%d" % flags.size())
	for s in flags:
		print("  ", s)
	quit(0)
