; Engine configuration file.
; Block Puzzle Game — original sliding-block puzzle.

config_version=5

[application]

config/name="Block Puzzle Game"
config/description="Original sliding-block color-gate puzzle."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/core/settings.gd"
Analytics="*res://scripts/services/analytics.gd"
IAP="*res://scripts/services/iap_service.gd"
Ads="*res://scripts/services/ads_service.gd"
Audio="*res://scripts/audio/audio_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://themes/main_theme.tres"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
